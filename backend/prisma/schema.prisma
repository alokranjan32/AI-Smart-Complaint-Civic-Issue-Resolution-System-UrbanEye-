  generator client {
  provider = "prisma-client-js"
}

 datasource db {
  provider = "postgresql"
}

model User {
  id             String   @id @default(uuid())
  name           String
  email          String   @unique
  password       String
  role           Role     @default(CITIZEN)
  xHandle        String   @default("")
  alertsEnabled  Boolean  @default(false)
  alertLatitude  Float?
  alertLongitude Float?
  alertRadiusKm  Float    @default(3)
  createdAt      DateTime @default(now())

  complaints Complaint[]
}

model Complaint {
  id              String             @id @default(uuid())
  title           String
  description     String
  location        String
  category        String             @default("General")
  priority        String             @default("MEDIUM")
  status          Status             @default(PENDING)
  department      String             @default("Civic Response Cell")
  sentiment       String             @default("concerned")
  confidence      Float              @default(0.0)
  suggestedAction String @default("")
  socialPost      String             @default("")
  image           String             @default("")
  latitude        Float              @default(25.5941)
  longitude       Float              @default(85.1376)
  upvotes         Int                @default(0)
  assignedTo      String             @default("")
  adminNote       String             @default("")

  userId          String
  user            User               @relation(fields: [userId], references: [id])
  history         ComplaintHistory[]

  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
}

model ComplaintHistory {
  id          String      @id @default(uuid())
  complaintId String
  complaint   Complaint   @relation(fields: [complaintId], references: [id], onDelete: Cascade)
  type        HistoryType
  actorName   String
  actorRole   Role
  message     String
  fromStatus  Status?
  toStatus    Status?
  department  String      @default("")
  assignedTo  String      @default("")
  note        String      @default("")
  createdAt   DateTime    @default(now())
}

enum Role {
  CITIZEN
  ADMIN
  AUTHORITY
}

enum Status {
  PENDING
  IN_PROGRESS
  RESOLVED
}

enum HistoryType {
  CREATED
  ASSIGNED
  STATUS_UPDATED
  NOTE
  RESOLVED
}
