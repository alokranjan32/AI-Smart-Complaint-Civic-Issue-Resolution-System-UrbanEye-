# UrbanEye backend environment

# Required database connection
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/civic_db

# Optional cache / queue layer
REDIS_URL=redis://localhost:6379

# AI service integration
AI_SERVICE_URL=http://127.0.0.1:8000

# API server runtime
HOST=0.0.0.0
PORT=5000

# Comma-separated web origins allowed to call the API in production
CORS_ORIGINS=https://YOUR_WEB_APP_DOMAIN

# Optional API cache tuning
COMPLAINT_CACHE_TTL_SECONDS=60
