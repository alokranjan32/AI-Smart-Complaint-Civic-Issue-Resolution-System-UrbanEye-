# UrbanEye web app environment

# Hosted backend API base URL. Keep the /api suffix.
NEXT_PUBLIC_API_URL=https://YOUR_BACKEND_DOMAIN/api

# Optional: only needed if the web app calls the AI service directly.
NEXT_PUBLIC_AI_SERVICE_URL=https://YOUR_AI_SERVICE_DOMAIN

# Android APK download URL used by website download buttons.
NEXT_PUBLIC_ANDROID_APK_URL=https://YOUR_APK_DOWNLOAD_URL.apk
